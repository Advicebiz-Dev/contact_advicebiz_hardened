<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="contact_advicebiz_hardened.ClickRevealPasswordField">
        <div class="advicebiz_password_field d-flex align-items-center gap-1">
            <!-- Existing records are deliberately read-only in the list.
                 A password can only be changed through the explicit edit
                 dialog, so masked bullets can never be silently overwritten. -->
            <t t-if="isExistingRecord">
                <input class="o_input flex-grow-1 advicebiz_password_stored_input"
                       t-ref="storedInput"
                       t-att-type="reveal.visible ? 'text' : 'password'"
                       readonly="readonly"
                       autocomplete="off"
                       t-att-value="reveal.visible ? reveal.plainText : maskedValue"/>

                <button t-if="hasStoredValue &amp;&amp; canViewPassword"
                        type="button"
                        class="btn btn-link p-0 advicebiz_password_icon advicebiz_password_eye"
                        t-att-title="revealTitle"
                        t-att-disabled="reveal.busy"
                        t-on-mousedown="stopMouseEvent"
                        t-on-click="toggleReveal">
                    <i t-att-class="reveal.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                </button>

                <button t-if="canEditExisting"
                        type="button"
                        class="btn btn-link p-0 advicebiz_password_icon advicebiz_password_edit"
                        title="Alterar password"
                        t-on-mousedown="stopMouseEvent"
                        t-on-click="openChangePassword">
                    <i class="fa fa-pencil"/>
                </button>

                <!-- Only after a successful authenticated reveal. -->
                <button t-if="canCopy"
                        type="button"
                        class="btn btn-link p-0 advicebiz_password_icon advicebiz_password_copy"
                        title="Copiar password"
                        t-on-mousedown="stopMouseEvent"
                        t-on-click="copyPassword">
                    <i class="fa fa-copy"/>
                </button>
            </t>

            <!-- A brand-new one2many row has no server record yet. It needs a
                 normal password input so the initial password can be created. -->
            <t t-else="">
                <input class="o_input flex-grow-1"
                       t-att-id="props.id"
                       t-att-type="reveal.visible &amp;&amp; hasDraftValue ? 'text' : 'password'"
                       t-att-readonly="!canModifyFields"
                       required="required"
                       autocomplete="new-password"
                       data-lpignore="true"
                       data-1p-ignore="true"
                       data-form-type="other"
                       t-att-maxlength="maxLength > 0 and maxLength"
                       t-att-placeholder="props.placeholder"
                       t-on-blur="onBlur"
                       t-ref="input"/>
                <button t-if="hasDraftValue"
                        type="button"
                        class="btn btn-link p-0 advicebiz_password_icon advicebiz_password_eye"
                        t-att-title="revealTitle"
                        t-on-mousedown="stopMouseEvent"
                        t-on-click="toggleReveal">
                    <i t-att-class="reveal.visible ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
                </button>
            </t>
        </div>
    </t>
</templates>
